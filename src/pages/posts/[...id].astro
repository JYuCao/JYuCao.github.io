---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPostUrl, getSummary, readingMinutes, tagSlug } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { id: post.id.replace(/\.(md|mdx)$/i, '') },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const description = getSummary(post, 155);
---

<BaseLayout title={post.data.title} description={description}>
  <main class="page-shell article-shell">
    <article class="prose post-content">
      <header class="article-header">
        <a class="back-link" href="/posts/">← 返回文章列表</a>
        <h1>{post.data.title}</h1>
        <p class="post-meta">
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          <span aria-hidden="true">·</span>
          <span>{readingMinutes(post.body)} 分钟阅读</span>
        </p>
        {post.data.tags.length > 0 && (
          <ul class="tag-list" aria-label="文章标签">
            {post.data.tags.map((tag) => <li><a href={`/tags/${tagSlug(tag)}/`}>{tag}</a></li>)}
          </ul>
        )}
      </header>
      <div class="article-body">
        <Content />
      </div>
      <footer class="article-footer">
        <a href={getPostUrl(post)} aria-label="本文永久链接">本文链接</a>
      </footer>
    </article>
  </main>
</BaseLayout>
