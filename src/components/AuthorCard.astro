---
interface AuthorLink {
  label: string;
  href: string;
  rel?: string;
}

interface Props {
  profile: {
    name: string;
    bio: string;
    avatar: string;
    avatarAlt: string;
    location?: string;
    links: AuthorLink[];
  };
}

const { profile } = Astro.props;
---

<aside class="author-card" aria-label={`${profile.name}的个人资料`}>
  <img src={profile.avatar} width="144" height="144" alt={profile.avatarAlt} />
  <div>
    <p class="author-name">{profile.name}</p>
    <p class="author-bio">{profile.bio}</p>
    <ul class="author-links">
      {profile.location && <li>{profile.location}</li>}
      {profile.links.map((link) => (
        <li><a href={link.href} rel={link.rel}>{link.label}</a></li>
      ))}
    </ul>
  </div>
</aside>
