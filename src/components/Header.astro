---
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="header-inner">
    <a class="site-title" href="/" aria-label="JYCao 的主页">JYCao</a>
    <nav aria-label="主导航">
      <a href="/" aria-current={path === '/' ? 'page' : undefined}>关于</a>
      <a href="/posts/" aria-current={path.startsWith('/posts/') ? 'page' : undefined}>文章</a>
      <a href="/tags/" aria-current={path.startsWith('/tags/') ? 'page' : undefined}>标签</a>
    </nav>
  </div>
</header>
